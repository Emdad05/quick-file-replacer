<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qr_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qr_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/qr_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Floating switch card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/qr_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/qr_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/switch_floating_service"
                        android:src="@drawable/ic_floating" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/switch_floating_service"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap floating icon to replace files anywhere"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_floating_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/qr_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/qr_surface_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_card_title"
                        android:textColor="@color/qr_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/qr_surface_card_stroke" />

                    <!-- Overlay Perm -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <View
                            android:id="@+id/dot_overlay"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_floating_button" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/perm_overlay"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_overlay_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp"
                            tools:text="Missing" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_grant_overlay"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_grant"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- All Files Access Perm -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <View
                            android:id="@+id/dot_all_files"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_floating_button" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/perm_all_files"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_all_files_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp"
                            tools:text="Missing" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_grant_all_files"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_grant"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- Built-in ADB Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot_adb"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_floating_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adb_label"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_adb_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp"
                            tools:text="Not connected" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pair_adb"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_pair"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_connect_adb"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_connect"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_options"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_TextButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1.3"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_dev_options"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- Shizuku Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot_shizuku"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_floating_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shizuku_label"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_shizuku_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp"
                            tools:text="Ready" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_shizuku_request"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_shizuku_req"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_shizuku_open"
                            style="@com.google.android.material.R.style.Widget_Material3_Button_OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_shizuku_open"
                            android:textSize="11sp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- Root Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot_root"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_floating_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/root_label"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_root_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textColor="@color/qr_text_secondary"
                            android:textSize="12sp"
                            tools:text="Not available" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/qr_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/qr_surface_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_selector_title"
                        android:textColor="@color/qr_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_mode_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rb_mode_auto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_auto"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_mode_adb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_adb_only"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_mode_shizuku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_shizuku_only"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_mode_root"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_root_only"
                            android:textColor="@color/qr_text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/options_list_title"
                    android:textColor="@color/qr_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_option"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_add_option"
                    android:textColor="@color/qr_background"
                    app:backgroundTint="@color/qr_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_empty_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="No options configured yet.\nTap '+ Add Option' to create your first replace target."
                android:textColor="@color/qr_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_option" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
